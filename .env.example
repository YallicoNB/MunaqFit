# ============================================
# MunaqFit - variables de entorno de ejemplo
# Copia este archivo como .env (gitignored) o configura
# estas variables en Render/Vercel. NUNCA subas secretos.
# ============================================

# --- Base de datos (TiDB Cloud / MySQL) ---
SPRING_DATASOURCE_URL=jdbc:mysql://HOST:4000/munaqfit_dev?useSSL=true&requireSSL=true&serverTimezone=America/Lima&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=USUARIO
SPRING_DATASOURCE_PASSWORD=CONTRASENA

# --- Perfil de Spring ---
SPRING_PROFILES_ACTIVE=local

# --- JWT ---
APP_JWT_SECRET=CAMBIA_ESTO_POR_UNA_CADENA_DE_32_O_MAS_CARACTERES
APP_JWT_EXPIRATION_MS=900000
APP_JWT_REFRESH_EXPIRATION_MS=604800000

# --- CORS ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_CORS_ALLOW_ALL=false

# --- Rate limit del login ---
APP_RATE_LIMIT_LOGIN_MAX=10
APP_RATE_LIMIT_LOGIN_WINDOW=60

# --- Swagger / logs ---
SWAGGER_ENABLED=true
SPRING_JPA_SHOW_SQL=false
LOG_LEVEL=INFO

# --- Hikari (opcional) ---
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=240000
SPRING_DATASOURCE_HIKARI_KEEPALIVE=120000
SPRING_DATASOURCE_HIKARI_VALIDATION_TIMEOUT=3000

# --- Izipay ---
IZIPAY_TOKEN_URL=
IZIPAY_SCRIPT_URL=
IZIPAY_MERCHANT_CODE=
IZIPAY_API_USER=
IZIPAY_API_PASSWORD=
IZIPAY_KEY_RSA=
# true SOLO en local/demo; false en produccion
IZIPAY_MOCK=false

# --- Render ---
# PORT lo inyecta Render automaticamente.
